# ==============================================================================
# SERVER-SIDE SECRETS (Never exposed to the browser)
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server runtime mode and port
NODE_ENV="development"
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# CLIENT-SIDE FIREBASE CONFIGURATION (VITE_ prefixed)
# ==============================================================================
# Optional: Overrides values from firebase-applet-config.json
# Get these credentials from Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# ==============================================================================
# GOOGLE MAPS PLATFORM (VITE_ prefixed)
# ==============================================================================
# Google Maps Platform API Key (or Demo Key)
# Get a production key from Google Cloud Console (enable Maps JavaScript API & Places API)
# or use a free prototype demo key
VITE_GOOGLE_MAPS_API_KEY=

