{
  "entities": {
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "User journal entry with AI reflections and conversation turns",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "turns": {
          "type": "array"
        },
        "summary": {
          "type": "string",
          "maxLength": 5000
        },
        "summaryModel": {
          "type": "string",
          "maxLength": 64
        },
        "isUserCustomTitle": {
          "type": "boolean"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt", "turns"]
    }
  },
  "firestore": {
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User journal entries strictly isolated by owner userId"
    }
  }
}
